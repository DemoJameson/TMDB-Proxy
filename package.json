{
	"name": "tmdb-proxy",
	"version": "1.1.0",
	"description": "TMDB API 反向代理与代理工具脚本模块",
	"type": "module",
	"scripts": {
		"build": "rollup -c && node scripts/build-modules.mjs",
		"build:dev": "rollup --config --configDev && node scripts/build-modules.mjs",
		"dev": "node scripts/serve-local.mjs",
		"serve:local": "node scripts/serve-local.mjs",
		"format:check": "biome check src scripts tests api package.json index.js rollup.config.js rollup.default.config.js rollup.dev.config.js vercel.json",
		"test": "node --test tests/*.test.mjs",
		"build:watch": "rollup -c -w"
	},
	"keywords": [
		"tmdb",
		"themoviedb",
		"proxy",
		"chinese",
		"nsnanocat",
		"script",
		"rollup",
		"hono"
	],
	"author": "DemoJameson",
	"license": "MIT",
	"dependencies": {
		"@biomejs/biome": "^2.4.11",
		"@hono/node-server": "^2.1.0",
		"@nsnanocat/grpc": "^1.1.0",
		"@nsnanocat/url": "^1.2.5",
		"@nsnanocat/util": "^2.6.11",
		"@upstash/redis": "^1.34.3",
		"crypto-js": "^4.2.0",
		"fetch-cookie": "^3.2.0",
		"hono": "^4.12.12",
		"node-fetch": "^3.3.2",
		"node-polyfill-webpack-plugin": "^4.1.0",
		"opencc-js": "^1.4.1"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^25.0.8",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"rollup": "^4.60.1"
	}
}
