#!name=TMDB 增强
#!desc=TMDB API 尽量补全中文标题、TV 演职员接口与角色名汉化，支持本地代理工具脚本和 Vercel/Workers 反向代理。
#!icon=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tmdb.png
#!homepage=https://github.com/DemoJameson/TMDB-Proxy
#!author=DemoJameson

[Argument]
aliasFallback = switch, "true", tag=中文标题, desc=缺少中文标题时，使用别名补全
characterTranslation = switch, "true", tag=中文角色名, desc=使用豆瓣数据将演职员中的中文角色名
aggregateCredits = switch, "true", tag=聚合演职人员, desc=演职人员数据从主演改为整剧/整季演员
imageWebp = switch, "true", tag=WebP 图片, desc=请求 TMDB 图片时优先获取 WebP 格式，更省流量
cacheBackend = input, "https://tmdb-proxy.demojameson.de5.net", tag=缓存后端, desc=远端缓存地址，留空使用默认地址

[Script]
# 追加 alternative_titles，并改写 TV credits 请求
http-request ^https:\/\/(?:api\.(?:themoviedb|tmdb)\.org|vidora-tmdb\.wwmm\.date)\/3\/(?:movie|tv|collection)\/\d+(?:(?:\/season\/\d+)?\/credits|\/alternative_titles)?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DemoJameson/TMDB-Proxy/main/dist/tmdb_proxy_request.js, timeout=10, argument=[{aliasFallback},{characterTranslation},{aggregateCredits},{imageWebp},{cacheBackend}], tag=TMDB Request
# 请求图片时优先 WebP 格式
http-request ^https:\/\/image\.tmdb\.org\/.*$ script-path=https://raw.githubusercontent.com/DemoJameson/TMDB-Proxy/main/dist/tmdb_proxy_request.js, timeout=10, argument=[{aliasFallback},{characterTranslation},{aggregateCredits},{imageWebp},{cacheBackend}], tag=TMDB Image Request
# 需要修改的 forwardinfo.vvebo.vip 反代请求重定向到 TMDB
http-request ^https:\/\/forwardinfo\.vvebo\.vip\/(?:movie|tv|collection)\/\d+(?:(?:\/season\/\d+)?\/credits|\/alternative_titles)?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DemoJameson/TMDB-Proxy/main/dist/tmdb_proxy_request.js, timeout=10, argument=[{aliasFallback},{characterTranslation},{aggregateCredits},{imageWebp},{cacheBackend}], tag=Forward 播放器反代重定向
# 中文详情或列表缺标题时从 alternative_titles 回填中文别名，演职员角色名使用豆瓣数据汉化
http-response ^https:\/\/(?:api\.(?:themoviedb|tmdb)\.org|vidora-tmdb\.wwmm\.date)\/3\/.*(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DemoJameson/TMDB-Proxy/main/dist/tmdb_proxy_response.js, requires-body=true, timeout=60, argument=[{aliasFallback},{characterTranslation},{aggregateCredits},{imageWebp},{cacheBackend}], tag=TMDB Response
# 中文列表缺标题时从 alternative_titles 回填中文别名，演职员角色名使用豆瓣数据汉化
http-response ^https:\/\/forwardinfo\.vvebo\.vip\/.*$ script-path=https://raw.githubusercontent.com/DemoJameson/TMDB-Proxy/main/dist/tmdb_proxy_response.js, requires-body=true, timeout=60, argument=[{aliasFallback},{characterTranslation},{aggregateCredits},{imageWebp},{cacheBackend}], tag=Forward 播放器反代响应

[MITM]
hostname = api.themoviedb.org, api.tmdb.org, vidora-tmdb.wwmm.date, image.tmdb.org, forwardinfo.vvebo.vip
