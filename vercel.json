{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "npm run build",
	"rewrites": [
		{ "source": "/api/:path*", "destination": "/api" },
		{ "source": "/cache/:path*", "destination": "/api" },
		{ "source": "/3/:path*", "destination": "/api" }
	],
	"headers": [
		{
			"source": "/api/:path*",
			"headers": [
				{
					"key": "x-vercel-enable-rewrite-caching",
					"value": "1"
				}
			]
		}
	]
}
